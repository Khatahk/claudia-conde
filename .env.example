# -------------------------------------------------------
# Configuración de conexión a Google Search Console (GSC)
# -------------------------------------------------------
# Copia este archivo como .env y rellena los valores.

# Opción 1: Service Account (recomendado para uso en servidor)
# Ruta al archivo JSON descargado desde Google Cloud Console
GSC_SERVICE_ACCOUNT_FILE=service_account.json

# Opción 2: Service Account como JSON inline (útil en CI/CD)
# GSC_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Opción 3: OAuth2 (para uso interactivo/local)
# Ruta al archivo credentials.json descargado desde Google Cloud Console
# GSC_CREDENTIALS_FILE=credentials.json

# URL del sitio a verificar en GSC (opcional; si no se define,
# se usará el primer sitio verificado de la cuenta)
# GSC_SITE_URL=https://www.ejemplo.com/
